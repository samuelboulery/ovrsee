node_modules/
dist/
.DS_Store

# Cookies de session utilisés par le crawl — ne doit jamais être versionné.
.ovrsee-auth.json
*.ovrsee-auth.json

# graphify-out/graph.json est VOLONTAIREMENT versionné : l'onglet Données le lit,
# et l'ovrsee doit rester consultable sur un projet qui ne compile plus. En
# revanche le cache et la visualisation se régénèrent depuis
# lui — les versionner ne ferait que du bruit dans les diffs.
graphify-out/cache/
graphify-out/graph.html

# Sous-produits de graphify au même titre que le cache : marqueur d'interpréteur,
# relevé de coût et manifeste d'exécution. Rien ne les lit ici, et ils
# apparaissaient en non-suivis à chaque `git status`.
graphify-out/.graphify_python
graphify-out/cost.json
graphify-out/manifest.json

# GRAPH_REPORT.md l'est aussi, pour une raison de plus : il change à CHAQUE
# reconstruction, même à code identique. Son en-tête compte les mots du corpus,
# et ce compte grimpe tout seul — 771 k, 778 k, 801 k, 831 k sur quatre commits
# d'affilée, dont le dernier ne touchait que ce fichier. Le graphe, lui, ne
# bouge pas d'un nœud (413 nœuds, 675 arêtes à chaque fois). D'où vient la
# dérive du compte relève de graphify, pas d'ici.
#
# Aucun code de l'ovrsee ne lit ce rapport : le versionner ne produisait qu'une
# ligne perpétuellement modifiée dans `git status`.
graphify-out/GRAPH_REPORT.md

# Coffre Obsidian : une traduction de ovrsee/ et de graphify-out/, réécrite à
# chaque export. Le versionner mettrait chaque plan et chaque ticket deux fois
# dans le dépôt, et chaque export ferait un diff qui n'apprend rien.
ovrsee/obsidian/

# Build de l app, reconstruit a la demande.
app/dist/

# Traduction de app/src en JavaScript, refaite à chaque `pnpm test`.
app/.test-build/

# Applications empaquetées, reconstruites à la demande.
release/

# Icône engendrée par scripts/make-icon.js.
build/icon-1024.png
build/icon.iconset/

# Version française de la vitrine : engendrée par scripts/build-site-fr.js au
# déploiement. La commiter la ferait dériver de site/index.html en silence.
site/fr/

# Captures d'écran ovrsee : régénérées à chaque commit, purge auto côté
# disque (30j puis 1/semaine) — inutile de les suivre dans git.
ovrsee/pages/shots/

# État de travail des sessions Claude (ovrsee) : local à une machine, jamais
# versionné.
ovrsee/.active/
ovrsee/.active-plan
ovrsee/.active-ticket
