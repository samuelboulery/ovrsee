{
  "name": "cockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "description": "Vue en lecture seule sur un projet vibecodé : plans capturés, pages crawlées, historique daté.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "node --test hooks/*.test.js crawl/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "cockpit:install": "node hooks/install.js",
    "cockpit:status": "node hooks/cockpit-cli.js status",
    "cockpit:crawl": "node crawl/index.js",
    "cockpit:auth": "node crawl/auth.js"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
