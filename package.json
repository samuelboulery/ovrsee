{
  "name": "ovrsee",
  "version": "0.9.0-beta",
  "private": true,
  "author": "Samuel Boulery",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "description": "Vue en lecture seule sur un projet vibecodé : plans capturés, pages crawlées, historique daté.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "node --test hooks/*.test.js crawl/*.test.js server/*.test.js mcp/*.test.js && node scripts/test-ui.js",
    "test:ui": "node scripts/test-ui.js",
    "typecheck": "tsc -p tsconfig.json",
    "ovrsee:install": "node hooks/install.js",
    "ovrsee:status": "node hooks/ovrsee-cli.js status",
    "ovrsee:close": "node hooks/ovrsee-cli.js close",
    "ovrsee:brief": "node hooks/ovrsee-session-start.js",
    "ovrsee:obsidian": "node hooks/ovrsee-cli.js obsidian",
    "ovrsee:crawl": "node crawl/index.js",
    "ovrsee:mcp": "node mcp/server.js",
    "ovrsee:auth": "node crawl/auth.js",
    "electron": "pnpm build:ui && electron .",
    "build:ui": "vite build",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "package": "pnpm build:ui && electron-builder --mac"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "main": "electron/main.js"
}
