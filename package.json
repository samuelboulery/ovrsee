{
  "name": "ovrsee",
  "version": "1.1.1-beta",
  "private": true,
  "license": "MIT",
  "author": "Samuel Boulery",
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelboulery/ovrsee.git"
  },
  "bugs": {
    "url": "https://github.com/samuelboulery/ovrsee/issues"
  },
  "homepage": "https://github.com/samuelboulery/ovrsee#readme",
  "description": "Gestion de projet pour Claude Code : plans approuvés, commits qui les réalisent, tickets à faire — versionnés dans le dépôt.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "node --test hooks/*.test.js crawl/*.test.js server/*.test.js mcp/*.test.js scripts/*.test.js electron/*.test.js && node scripts/test-ui.js",
    "test:ui": "node scripts/test-ui.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint hooks crawl server mcp electron app/src site",
    "ovrsee:install": "node hooks/install.js",
    "ovrsee:status": "node hooks/ovrsee-cli.js status",
    "ovrsee:close": "node hooks/ovrsee-cli.js close",
    "ovrsee:reconcile": "node hooks/ovrsee-cli.js reconcile",
    "ovrsee:brief": "node hooks/ovrsee-session-start.js",
    "ovrsee:obsidian": "node hooks/ovrsee-cli.js obsidian",
    "ovrsee:crawl": "node crawl/index.js",
    "ovrsee:mcp": "node mcp/server.js",
    "ovrsee:auth": "node crawl/auth.js",
    "electron": "pnpm build:ui && electron .",
    "build:ui": "vite build",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "icon": "node scripts/make-icon.js",
    "package:mac": "pnpm build:ui && electron-builder --mac",
    "package:win": "pnpm build:ui && electron-builder --win"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.80.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "playwright-core": "^1.62.1"
  },
  "main": "electron/main.js"
}
